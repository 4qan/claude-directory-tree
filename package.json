{
  "name": "claude-directory-tree",
  "version": "0.1.4",
  "description": "Visual file-explorer for all your Claude Code artifacts across projects and scopes",
  "type": "module",
  "bin": {
    "claude-directory-tree": "dist/cli.js"
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/4qan/claude-directory-tree.git"
  },
  "homepage": "https://github.com/4qan/claude-directory-tree",
  "author": "Furqan Tariq",
  "engines": {
    "node": ">=20.17.0"
  },
  "scripts": {
    "build:server": "tsup",
    "build:client": "vite build",
    "build": "npm run build:server && npm run build:client",
    "dev:server": "tsup --watch",
    "dev:client": "vite",
    "prepublishOnly": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "claude",
    "claude-code",
    "artifacts",
    "directory-tree"
  ],
  "license": "MIT",
  "dependencies": {
    "@fastify/cors": "^11.2.0",
    "@fastify/static": "^9.0.0",
    "@headless-tree/core": "^1.6.3",
    "@headless-tree/react": "^1.6.3",
    "@radix-ui/react-slot": "^1.2.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fastify": "^5.8.4",
    "fastify-type-provider-zod": "^6.1.0",
    "get-port": "^7.2.0",
    "gray-matter": "^4.0.3",
    "lucide-react": "^1.7.0",
    "open": "^11.0.0",
    "tailwind-merge": "^3.5.0",
    "write-file-atomic": "^7.0.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.2.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/write-file-atomic": "^4.0.3",
    "@vitejs/plugin-react": "^6.0.1",
    "happy-dom": "^20.8.9",
    "playwright": "^1.59.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "tailwindcss": "^4.2.2",
    "tsup": "^8.5.1",
    "typescript": "^6.0.2",
    "vite": "^8.0.3",
    "vitest": "^4.1.2"
  }
}
